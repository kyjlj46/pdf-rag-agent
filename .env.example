# OpenAI 호환 엔드포인트 (vLLM 등)
OPENAI_API_KEY=your-key
OPENAI_API_BASE=http://host:port/v1
OPENAI_MODEL=openai/gpt-oss-120b
# 단계별로 다른 모델을 쓰려면 지정 (비우면 OPENAI_MODEL 사용)
# RAG_MODEL=
# SUBAGENT_MODEL=
# OCR_MODEL=      # OCR 결과를 정리하는 LLM (텍스트 전용이어도 됨)
# OCR_WORKERS=4   # 페이지 정리 LLM 동시 호출 수
# MAX_TOKENS=8192
# LLM_TEMPERATURE=   # 샘플링 온도 (비우면 서버 기본값)
# LLM_STREAMING=0    # 1 이면 모델 응답을 토큰 단위로 스트리밍. vLLM(gpt-oss) 스트리밍은 글자 조각이 빠지는 문제가 있어 기본 끔
# 이미지 분석: 이미지를 볼 수 있는 모델 (비우면 OCR 로 읽은 글자·배치만으로 분석)
# VISION_MODEL=
# VISION_API_BASE=   # 비우면 OPENAI_API_BASE
# VISION_API_KEY=    # 비우면 OPENAI_API_KEY
# 메일 발송 (이메일 작성 결과의 📤 메일 보내기). 비우면 '메일 앱으로 열기' 만 쓸 수 있음
# SMTP_HOST=smtp.gmail.com     # Office 365: smtp.office365.com
# SMTP_PORT=587
# SMTP_SECURITY=starttls        # starttls | ssl(보통 465) | none
# SMTP_USER=me@example.com
# SMTP_PASSWORD=                # Gmail 은 '앱 비밀번호'
# SMTP_FROM=홍길동 <me@example.com>
# OCR_SECOND_PASS=1             # 촘촘한 두 번째 글자 검출로 놓친 줄을 채움 (0 이면 끔, 페이지당 1~2초 절약)
# 웹 검색 Agent (API 키 불필요). 결과가 없으면 엔진을 바꿔 보세요
# WEB_SEARCH_BACKEND=bing,google,yahoo
# WEB_SEARCH_REGION=kr-kr
